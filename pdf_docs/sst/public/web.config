<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config — Application SST DREETS BFC
  Configuration IIS pour le déploiement en production.
  
  PAS BESOIN du module URL Rewrite ! L'application utilise
  un routage par query string (index.php?page=...), donc
  IIS sert directement les fichiers PHP sans réécriture.
  
  Prérequis IIS :
  - PHP configuré via FastCGI (Handler Mapping *.php → php-cgi.exe)
  - Windows Authentication activée, Anonymous désactivée
  - index.php comme document par défaut
-->
<configuration>
  <system.webServer>

    <!-- ============================================================ -->
    <!-- Document par défaut                                          -->
    <!-- ============================================================ -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ============================================================ -->
    <!-- Sécurité : bloquer l'accès aux fichiers sensibles            -->
    <!-- ============================================================ -->
    <security>
      <requestFiltering>
        <!-- Bloquer l'accès direct aux fichiers sensibles -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sqlite3" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".swp" allowed="false" />
        </fileExtensions>

        <!-- Bloquer les segments de chemin sensibles -->
        <hiddenSegments>
          <add segment="data" />
          <add segment="src" />
          <add segment="handlers" />
          <add segment="pages" />
          <add segment="templates" />
          <add segment="queries" />
          <add segment="middleware" />
          <add segment="vendor" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
            <authentication>
                <windowsAuthentication enabled="true" />
                <anonymousAuthentication enabled="false" />
            </authentication>
    </security>

    <!-- ============================================================ -->
    <!-- En-têtes de sécurité HTTP                                    -->
    <!-- ============================================================ -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- ============================================================ -->
    <!-- Erreurs détaillées (pour voir les erreurs IIS)               -->
    <!-- Les erreurs PHP sont gérées par display_errors=On            -->
    <!-- dans config.php et php.ini                                   -->
    <!-- ============================================================ -->
    <httpErrors errorMode="Detailed" />

  </system.webServer>

  <!-- ============================================================ -->
  <!-- Authentification Windows IIS                                  -->
  <!-- Configurer via IIS Manager > Authentication :                 -->
  <!--   - Désactiver : Anonymous Authentication                     -->
  <!--   - Activer : Windows Authentication                          -->
  <!--   - Providers : Negotiate, NTLM                               -->
  <!--                                                               -->
  <!-- Alternativement, décommenter ci-dessous :                     -->
  <!-- ============================================================ -->
  <!--
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>
    <identity impersonate="false" />
  </system.web>
  -->

  <!-- ============================================================ -->
  <!-- Handler FastCGI PHP                                           -->
  <!-- Normalement configuré via IIS Manager, mais décommenter si    -->
  <!-- vous voulez le définir ici :                                  -->
  <!-- ============================================================ -->
  <!--
  <system.webServer>
    <handlers>
      <add name="PHP83_via_FastCGI"
           path="*.php"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Unspecified" />
    </handlers>
  </system.webServer>
  -->
</configuration>

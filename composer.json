{
    "name": "dreets-bfc/sst-app",
    "description": "Application SST DREETS Bourgogne-Franche-Comté",
    "type": "project",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "ekino/phpstan-banned-code": "^3.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.34",
        "phparkitect/phparkitect": "*",
        "phpro/grumphp": "*",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13",
        "rector/rector": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/config.php",
            "src/helpers.php",
            "src/queries/user_queries.php",
            "src/queries/report_queries.php",
            "src/queries/site_queries.php",
            "src/user_context.php"
        ]
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpstan:baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "phparkitect": "phparkitect check",
        "test": "phpunit --testdox",
        "test:coverage": "phpunit --coverage-html=data/coverage"
    },
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpro/grumphp": true
        }
    }
}

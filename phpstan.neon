includes:
    - phpstan-baseline.neon
    - phpstan-no-magic-string.neon
    - phpstan-banned-code.neon

parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    paths:
        - src/
        - pages/
        - templates/
        - handlers/
        - tools/
        - seed/
        - public/
        - nuclear-reset.php
        - seed.php
    excludePaths:
        - vendor/
        - src/lib/
        - tests/
    bootstrapFiles:
        - vendor/autoload.php
        - phpstan-bootstrap.php
        - src/lib/fpdf/fpdf.php
        - src/lib/Parsedown.php
    scanDirectories:
        - src/
        - handlers/

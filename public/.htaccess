# Apache .htaccess — Application SST DREETS BFC
# Complete configuration: URL rewriting, security headers,
# caching, and file protection.
# Gzip compression is handled by PHP (ob_gzhandler), not Apache.

# ============================================================
# 1. URL Rewriting
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route all requests through index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ============================================================
# 2. Security Headers
# ============================================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none';"

    # HSTS (force HTTPS) — activate only if HTTPS is properly configured
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Remove server signature
    Header unset Server
    ServerSignature Off
</IfModule>

# ============================================================
# 3. Cache-Control — No-cache for dynamic PHP pages
# ============================================================
<IfModule mod_headers.c>
    # PHP pages: never cache (always revalidate)
    <FilesMatch "\.(php|phtml)$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    # Static assets: cache with version busting via query string
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>

    # Images: cache for 30 days
    <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Fonts: cache for 1 year
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================
# 4. File Protection & Security
# ============================================================
# Protect sensitive files
<FilesMatch "\.(sql|db|sqlite|sqlite3|log|env|bak|swp|php~|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to hidden directories (vendor, src, data, etc.)
<IfModule mod_rewrite.c>
    RewriteRule ^(src|data|vendor|templates|pages|handlers|middleware|queries)/ - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Prevent ETag headers (reduces bandwidth, avoids cache issues)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

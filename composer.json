{
    "name": "dreets-bfc/sst-app",
    "description": "Application SST DREETS Bourgogne-Franche-Comté",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.0",
        "infection/infection": "^0.29"
    },
    "autoload": {
        "files": [
            "src/config.php",
            "src/helpers.php",
            "src/queries/user_queries.php",
            "src/queries/report_queries.php",
            "src/queries/site_queries.php",
            "src/queries/stats_queries.php",
            "src/user_context.php"
        ]
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpstan:baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "test": "phpunit --testdox",
        "test:coverage": "phpunit --coverage-html=data/coverage"
    },
    "config": {
        "vendor-dir": "vendor",
        "sort-packages": true
    }
}

{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.29.x/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "lib"
        ]
    },
    "timeout": 10,
    "testFrameworkOptions": "--testsuite=\"SST Unit Tests\"",
    "logs": {
        "text": "data/infection.log",
        "summary": "data/infection-summary.log",
        "perMutator": "data/infection-mutations.log"
    },
    "tmpDir": "data/infection-tmp",
    "phpUnit": {
        "configDir": "."
    },
    "mutators": {
        "@default": true
    },
    "minMsi": 80,
    "minCoveredMsi": 80
}

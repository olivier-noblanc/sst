parameters:
	ignoreErrors:
		-
			message: '#^Offset ''weight'' on array\{word\: string, weight\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: handlers/settings_handler.php

		-
			message: '#^Offset ''word'' on array\{word\: string, weight\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: handlers/settings_handler.php

		-
			message: '#^Offset ''id'' on array\{id\: int\|string, nom\: string, prenom\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/DTO/CreateReportCommand.php

		-
			message: '#^Offset ''nom'' on array\{id\: int\|string, nom\: string, prenom\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/DTO/CreateReportCommand.php

		-
			message: '#^Offset ''prenom'' on array\{id\: int\|string, nom\: string, prenom\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/DTO/CreateReportCommand.php

		-
			message: '#^Offset ''uuid'' on non\-empty\-array\<mixed\> on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: templates/sidebar.php

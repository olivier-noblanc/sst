includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    treatPhpDocTypesAsCertain: false
    paths:
        - src/
        - pages/
        - templates/
        - handlers/
        - public/index.php
        - public/asset.php
    excludePaths:
        - vendor/
        - src/lib/
        - tests/
    bootstrapFiles:
        - phpstan-bootstrap.php
        - src/lib/fpdf/fpdf.php
        - src/lib/Parsedown.php
    scanDirectories:
        - src/
        - handlers/

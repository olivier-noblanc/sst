parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$num of function dechex expects int, int\<0, max\>\|false given\.$#'
			identifier: argument.type
			count: 2
			path: public/css.php

		-
			message: '#^Parameter \#1 \$string of function crc32 expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: public/css.php

		-
			message: '#^Parameter \#2 \$timestamp of function gmdate expects int\|null, int\<0, max\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: public/css.php

		-
			message: '#^Parameter \#1 \$haystack of function str_starts_with expects string, string\|false\|null given\.$#'
			identifier: argument.type
			count: 3
			path: public/router.php

		-
			message: '#^Variable \$pdo might not be defined\.$#'
			identifier: variable.undefined
			count: 2
			path: seed/_registries.php

		-
			message: '#^Variable \$pdo might not be defined\.$#'
			identifier: variable.undefined
			count: 4
			path: seed/_reports.php

		-
			message: '#^Variable \$sampleReports might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: seed/_reports.php

		-
			message: '#^Variable \$pdo might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: seed/_sites.php

		-
			message: '#^Variable \$pdo might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: seed/_users.php

		-
			message: '#^Parameter \#1 \$stream of function fclose expects resource, resource\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tools/anonymize_old_reports.php

		-
			message: '#^Parameter \#1 \$stream of function fgets expects resource, resource\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tools/anonymize_old_reports.php

		-
			message: '#^Parameter \#1 \$string of function trim expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tools/anonymize_old_reports.php

		-
			message: '#^Parameter \#2 \$timestamp of function date expects int\|null, int\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tools/anonymize_old_reports.php

		-
			message: '#^Argument of an invalid type list\<string\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 2
			path: tools/check_css_classes.php

		-
			message: '#^Function scanDirForClasses\(\) has parameter \$excludedStrings with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tools/check_css_classes.php

		-
			message: '#^Function scanDirForClasses\(\) has parameter \$htmlClasses with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tools/check_css_classes.php

		-
			message: '#^Parameter \#2 \$subject of function preg_match_all expects string, string\|null given\.$#'
			identifier: argument.type
			count: 4
			path: tools/check_css_classes.php

		-
			message: '#^Parameter \#3 \$subject of function preg_replace expects array\<float\|int\|string\>\|string, string\|false given\.$#'
			identifier: argument.type
			count: 3
			path: tools/check_css_classes.php

		-
			message: '#^Parameter \#3 \$subject of function preg_replace expects array\<float\|int\|string\>\|string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: tools/check_css_classes.php

		-
			message: '#^Variable \$argv might not be defined\.$#'
			identifier: variable.undefined
			count: 3
			path: tools/check_css_classes.php

		-
			message: '#^Parameter \#2 \$timestamp of function gmdate expects int\|null, int\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tools/check_delays.php

		-
			message: '#^Comparison operation "\>" between 0 and 0 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 2
			path: tools/tests/test_can_access_report.php

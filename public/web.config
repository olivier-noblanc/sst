<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config — Application SST DREETS BFC
  Configuration IIS minimale pour le déploiement en production.

  TOUT passe par l'authentification Windows :
  - AUCUN accès anonyme (même asset.php require Windows Auth)
  - Les assets statiques (CSS, images, fonts) sont servis par asset.php
  - L'accès HTTP direct aux répertoires css/, img/, fonts/, js/ est bloqué
    → seul asset.php peut les lire via le système de fichiers PHP
  - Headers de sécurité gérés par PHP (header.php / asset.php)
  - Compression gzip via ob_gzhandler dans index.php

  ICI : uniquement ce qu'IIS doit faire AVANT PHP :
  - Document par défaut
  - Bloquer l'accès aux fichiers/dossiers sensibles
  - Bloquer l'accès direct aux assets statiques (forcer le passage par asset.php)
  - MIME types manquants (IIS ne connaît pas .woff2 par défaut)
  - Authentification Windows sur TOUT, Anonymous désactivée PARTOUT

  Prérequis IIS :
  - PHP configuré via FastCGI (Handler Mapping *.php → php-cgi.exe)
  - Windows Authentication activée, Anonymous désactivée (aucune exception)
  - Module URL Rewrite installé (optionnel, pour redirection propre des assets)
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- Document par défaut -->
      <defaultDocument>
        <files>
          <clear />
          <add value="index.php" />
        </files>
      </defaultDocument>

      <!-- Bloquer l'accès aux fichiers et dossiers sensibles
           + bloquer l'accès direct aux assets statiques
           (seul asset.php peut les servir, via readfile() côté PHP) -->
      <security>
        <requestFiltering>
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".sql" allowed="false" />
            <add fileExtension=".db" allowed="false" />
            <add fileExtension=".sqlite" allowed="false" />
            <add fileExtension=".sqlite3" allowed="false" />
            <add fileExtension=".log" allowed="false" />
            <add fileExtension=".env" allowed="false" />
            <add fileExtension=".bak" allowed="false" />
          </fileExtensions>
          <hiddenSegments>
            <add segment="data" />
            <add segment="src" />
            <add segment="handlers" />
            <add segment="pages" />
            <add segment="templates" />
            <add segment="queries" />
            <add segment="middleware" />
            <add segment="vendor" />
            <add segment=".git" />
            <!-- Assets statiques : bloquer l'accès HTTP direct
                 → forcer le passage par asset.php (qui require Windows Auth)
                 asset.php lit les fichiers via readfile() (accès filesystem,
                 pas HTTP), donc ces segments cachés ne l'affectent pas. -->
            <add segment="css" />
            <add segment="img" />
            <add segment="fonts" />
            <add segment="js" />
          </hiddenSegments>
        </requestFiltering>
            <authentication>
                <windowsAuthentication enabled="true" />
                <anonymousAuthentication enabled="false" />
            </authentication>
      </security>

      <!-- MIME types que IIS ne connaît pas par défaut -->
      <staticContent>
        <remove fileExtension=".woff" />
        <mimeMap fileExtension=".woff" mimeType="font/woff" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        <remove fileExtension=".svg" />
        <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      </staticContent>

      <!-- Headers HTTP de sécurité — fallback uniquement
           En production, asset.php gère les headers des assets statiques.
           Ces customHeaders ne s'appliquent qu'aux rares fichiers servis
           directement par IIS (erreurs 404 personnalisées, etc.)
           Note: <remove name="Server" /> dans customHeaders NE SUPPRIME PAS
           le header Server d'IIS (il est ajouté trop tard dans le pipeline).
           La règle URL Rewrite sortante ci-dessous le fait. -->
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Content-Security-Policy" value="default-src 'self'; style-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <!-- URL Rewrite — Supprimer le header Server (version IIS)
           Prérequis : module URL Rewrite doit être installé sur IIS
           Cette règle outbound remplace la valeur du header Server par une chaîne vide. -->
      <rewrite>
        <outboundRules>
          <rule name="Remove Server Header" enabled="true">
            <match serverVariable="RESPONSE_Server" pattern=".*" />
            <action type="Rewrite" value="" />
          </rule>
        </outboundRules>
      </rewrite>

    </system.webServer>
  </location>
</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config racine — Application SST DREETS BFC

  Ce fichier est à la racine du dépôt pour référence.
  Le fichier actif utilisé par IIS est dans public/web.config

  PAS BESOIN du module URL Rewrite ! L'application utilise
  un routage par query string (index.php?page=...).

  TOUT passe par l'authentification Windows :
  - Aucun accès anonyme (Anonymous désactivé)
  - Même les assets statiques (CSS, images, fonts) passent par asset.php
    qui nécessite Windows Auth
  - L'accès direct aux répertoires css/, img/, fonts/, js/ est bloqué
    par hiddenSegments dans public/web.config

  Le site IIS doit pointer vers C:\inetpub\sst\public\
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" useKernelMode="true">
          <extendedProtection tokenChecking="Allow" />
        </windowsAuthentication>
      </authentication>
    </security>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
